<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= product.name %> - CodeAlpha Store</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #222;
        }

        /* Navbar */
        .navbar {
            background: #111827;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 22px;
            list-style: none;
        }

        .nav-links a {
            color: #d1d5db;
            text-decoration: none;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: white;
        }

        /* Product Section */
        .product-container {
            max-width: 1100px;
            margin: 60px auto;
            padding: 0 20px;
        }

        .product-card {
            background: white;
            border-radius: 18px;
            padding: 35px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .product-image {
            width: 100%;
            height: 420px;
            object-fit: cover;
            border-radius: 14px;
        }

        .category {
            display: inline-block;
            background: #eef2ff;
            color: #4f46e5;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .product-info h1 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .price {
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .description {
            color: #6b7280;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .stock {
            margin-bottom: 25px;
            font-weight: bold;
        }

        .add-btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: #111827;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: 0.2s;
        }

        .add-btn:hover {
            background: #374151;
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

        /* Footer */
        footer {
            margin-top: 80px;
            background: #111827;
            color: #9ca3af;
            text-align: center;
            padding: 25px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
            }

            .product-card {
                grid-template-columns: 1fr;
                padding: 22px;
            }

            .product-image {
                height: 300px;
            }

            .product-info h1 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">

        <div class="logo">
            CodeAlpha Store
        </div>

        <ul class="nav-links">
            <li><a href="/products">Products</a></li>
            <li><a href="/cart">Cart</a></li>
            <li><a href="/orders">My Orders</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>

    </nav>


    <!-- Product Details -->

    <main class="product-container">

        <div class="product-card">

            <div>
                <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                    class="product-image"
                >
            </div>


            <div class="product-info">

                <span class="category">
                    <%= product.category %>
                </span>

                <h1>
                    <%= product.name %>
                </h1>

                <div class="price">
                    ₹<%= product.price %>
                </div>

                <p class="description">
                    <%= product.description %>
                </p>

                <p class="stock">
                    Available Stock: <%= product.stock %>
                </p>

                <form action="/cart/add/<%= product._id %>" method="POST">

                    <button
                        type="submit"
                        class="add-btn"
                    >
                        🛒 Add to Cart
                    </button>

                </form>

                <a href="/products" class="back-link">
                    ← Back to Products
                </a>

            </div>

        </div>

    </main>


    <!-- Footer -->

    <footer>
        © 2026 CodeAlpha Store. All rights reserved.
    </footer>

</body>
</html>